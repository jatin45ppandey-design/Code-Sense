# Copy this file to .env and replace every placeholder before starting Docker.
POSTGRES_DB=devguide
POSTGRES_USER=devguide
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5433

# Use these values when running the Spring Boot service locally.
DATABASE_URL=jdbc:postgresql://localhost:5433/devguide
DATABASE_USERNAME=devguide
DATABASE_PASSWORD=replace-with-the-same-long-random-password

# GitHub OAuth2 application credentials. Create them in GitHub Developer Settings.
GITHUB_CLIENT_ID=replace-with-your-github-client-id
GITHUB_CLIENT_SECRET=replace-with-your-github-client-secret
FRONTEND_URL=http://localhost:3000

# Set true when the backend is served over HTTPS.
SESSION_COOKIE_SECURE=false

# Used to encrypt GitHub access tokens stored in the database.
TOKEN_ENCRYPTION_PASSWORD=replace-with-a-long-random-secret
TOKEN_ENCRYPTION_SALT=replace-with-16-hex-characters

# Required only when using the `openai` Spring profile.
OPENAI_API_KEY=

# Required when using the default `api4students` Spring profile.
API4STUDENTS_API_KEY=
